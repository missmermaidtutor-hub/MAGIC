rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Users can read/write their own artwork images
    match /artworks/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Users can read/write their own courage uploads
    match /courages/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
